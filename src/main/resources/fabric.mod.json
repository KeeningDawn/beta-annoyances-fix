{
	"schemaVersion": 1,
	"id": "modern-beta-annoyances-fix",
	"version": "${version}",
	"name": "Modern Beta Annoyances Fix",
	"description": "Clientside-only fixes for gaps the Modern Beta server doesn't/can't enforce, preventing client/server desyncs and annoyances. Not affiliated with or endorsed by Modern Beta LLC.",
	"authors": [
		"KeeningDawn"
	],
	"contact": {
		"issues": "https://github.com/KeeningDawn/modern-beta-annoyances-fix/issues",
		"sources": "https://github.com/KeeningDawn/modern-beta-annoyances-fix"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/modern-beta-annoyances-fix/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"io.github.keeningdawn.modernbetaannoyancesfix.ModernBetaAnnoyancesFix"
		],
		"client": [
			"io.github.keeningdawn.modernbetaannoyancesfix.client.ModernBetaAnnoyancesFixClient"
		],
		"modmenu": [
			"io.github.keeningdawn.modernbetaannoyancesfix.client.ModernBetaAnnoyancesFixModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "modern-beta-annoyances-fix.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}